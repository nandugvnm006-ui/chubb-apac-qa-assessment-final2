{
  "name": "assessment-login-qa",
  "version": "1.0.0",
  "private": true,
  "description": "Self-contained Playwright login testing example with a small local source application",
  "scripts": {
    "start:test-app": "node src/server.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
